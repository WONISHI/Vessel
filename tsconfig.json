{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@vessel/obsidian": ["./packages/obsidian/src/index.ts"],
      "@vessel/obsidian/*": ["./packages/obsidian/src/*"],
      "@vessel/type": ["./packages/type/src/index.ts"],
      "@vessel/type/*": ["./packages/type/src/*"],
      "@vessel/utils": ["./packages/utils/src/index.ts"],
      "@vessel/utils/*": ["./packages/utils/src/*"]
    }
  }
}
