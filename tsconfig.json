{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.web.json"
    }
  ],
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@vessel/obsidian": [
        "./packages/@vessel/obsidian/src/index.ts"
      ],
      "@vessel/obsidian/*": [
        "./packages/@vessel/obsidian/src/*"
      ],
      "@vessel/type": [
        "./packages/@vessel/type/src/index.ts"
      ],
      "@vessel/type/*": [
        "./packages/@vessel/type/src/*"
      ],
      "@vessel/utils": [
        "./packages/@vessel/utils/src/index.ts"
      ],
      "@vessel/utils/*": [
        "./packages/@vessel/utils/src/*"
      ],
      "@vessel/markdown-table": [
        "./packages/@vessel/markdown-table/src/index.ts"
      ],
      "@vessel/markdown-table/*": [
        "./packages/@vessel/markdown-table/src/*"
      ],
      "@preload/*": [
        "./src/preload/*"
      ]
    }
  }
}
