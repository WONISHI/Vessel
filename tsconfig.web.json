{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@vessel/type": [
        "./packages/@vessel/type/src/index.ts"
      ],
      "@vessel/type/*": [
        "./packages/@vessel/type/src/*"
      ],
      "@vessel/utils": [
        "./packages/@vessel/utils/src/index.ts"
      ],
      "@vessel/utils/*": [
        "./packages/@vessel/utils/src/*"
      ],
      "@vessel/markdown-table": [
        "./packages/@vessel/markdown-table/src/index.ts"
      ],
      "@vessel/markdown-table/*": [
        "./packages/@vessel/markdown-table/src/*"
      ],
      "@preload/*": [
        "./src/preload/*"
      ],
      "@vessel/obsidian": [
        "./packages/@vessel/obsidian/src/index.ts"
      ]
    }
  }
}
