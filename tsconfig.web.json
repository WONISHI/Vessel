{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@/*": ["./src/renderer/src/*"],
      "@vessel/type": ["./packages/type/src/index.ts"],
      "@vessel/type/*": ["./packages/type/src/*"],
      "@vessel/utils": ["./packages/utils/src/index.ts"],
      "@vessel/utils/*": ["./packages/utils/src/*"]
    }
  }
}
