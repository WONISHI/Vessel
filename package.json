{
  "name": "vessel",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "WONISHI",
  "homepage": "https://electron-vite.org",
  "build": {
    "appId": "com.your.app",
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/node-pty/**/*",
      "**/node_modules/@parcel/watcher*/**/*"
    ],
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "npmRebuild": true,
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "extraResources": [
      {
        "from": "resources/office",
        "to": "office"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "compression": "maximum"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "scripts": {
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:database": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/main/database.test.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "fix": "npm run lint -- --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:obsidian && npm run typecheck:utils && npm run typecheck:router && npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "dev:main": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-pty.cjs && node scripts/prepare-monaco-locale.cjs",
    "rebuild:deps": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck:router": "npm run typecheck --workspace=@vessel/react-router",
    "typecheck:utils": "npm run typecheck --workspace=@vessel/utils",
    "typecheck:obsidian": "npm run typecheck --workspace=@vessel/obsidian",
    "predev": "node scripts/prepare-dev-icon.cjs",
    "predev:main": "node scripts/prepare-dev-icon.cjs",
    "prestart": "node scripts/prepare-dev-icon.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@parcel/watcher": "^2.6.0",
    "better-sqlite3": "^12.4.1",
    "node-pty": "^1.1.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.13",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@monaco-editor/loader": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@oovz/esearch-ocr": "8.4.4",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@uiw/react-codemirror": "^4.25.4",
    "@vessel/obsidian": "file:packages/obsidian",
    "@vessel/react-router": "file:packages/react-router",
    "@vessel/utils": "file:packages/utils",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "js-web-screen-shot": "^2.0.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "monaco-editor": "^0.55.1",
    "onnxruntime-web": "1.22.0",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.88.0",
    "react-live-clock": "^6.1.25",
    "react-pdf": "10.2.0",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.12.0",
    "sonner": "^2.0.7",
    "stacktrace-js": "^2.0.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vditor": "^3.11.2",
    "vite": "^7.2.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "wasm-onlyoffice-sdk": "^0.1.7",
    "zustand": "^5.0.10"
  },
  "volta": {
    "node": "20.20.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
