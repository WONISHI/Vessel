  },
  "imports": {
    "#vessel-utils/calendar": "./src/calendar/index.ts",
    "#vessel-utils/types": "./src/types.ts",
    "#vessel-utils/file-tree": "./src/file-tree.ts",
    "#vessel-utils/files": "./src/files.ts",
    "#vessel-utils/browser-history-url": "./src/browser-history-url.ts",
    "#vessel-utils/local-file-url": "./src/local-file-url.ts",
    "#vessel-utils/shortcuts": "./src/shortcuts.ts",
