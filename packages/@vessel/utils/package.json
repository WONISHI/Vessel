    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@vessel/type": "file:../type",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "scripts": {
