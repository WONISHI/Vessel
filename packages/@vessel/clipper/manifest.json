{
  "manifest_version": 3,
  "name": "Vessel Clipper - 网页剪藏",
  "version": "1.0.0",
  "description": "一键将网页内容、文章、选中文本或网址书签剪藏并保存到 Vessel 知识库",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:35678/*", "http://localhost:35678/*"],
  "action": {
    "default_popup": "dist/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
